{
  "name": "faxal-lang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "dev:all": "make -C native && node --watch server/index.ts & vite",
    "build": "make -C native && tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "vitest run && make -C native test",
    "native": "make -C native"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
